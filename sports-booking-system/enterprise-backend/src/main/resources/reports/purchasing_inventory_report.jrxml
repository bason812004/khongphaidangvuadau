<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="purchasing_inventory_report"
              pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="c1b2a3d4-e5f6-4789-a012-3456789abcde">

    <parameter name="REPORT_TITLE" class="java.lang.String"/>
    <parameter name="GENERATED_BY" class="java.lang.String"/>
    <parameter name="REPORT_DATE" class="java.lang.String"/>
    <parameter name="TOTAL_ITEMS" class="java.lang.Integer"/>
    <parameter name="TOTAL_VALUE" class="java.lang.Double"/>

    <field name="sku" class="java.lang.String"/>
    <field name="productName" class="java.lang.String"/>
    <field name="category" class="java.lang.String"/>
    <field name="stockQuantity" class="java.lang.Integer"/>
    <field name="costPrice" class="java.lang.Double"/>
    <field name="sellingPrice" class="java.lang.Double"/>

    <title>
        <band height="90" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="80" backcolor="#047857" uuid="a1b2c3d4-0001-0002-0003-000000000001"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="20" y="15" width="340" height="30" forecolor="#FFFFFF" uuid="a1b2c3d4-0001-0002-0003-000000000002"/>
                <textElement verticalAlignment="Middle"><font size="20" isBold="true"/></textElement>
                <text><![CDATA[INVENTORY & PURCHASING]]></text>
            </staticText>
            <textField>
                <reportElement x="20" y="48" width="340" height="20" forecolor="#D1FAE5" uuid="a1b2c3d4-0001-0002-0003-000000000003"/>
                <textElement><font size="11"/></textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="370" y="20" width="170" height="18" forecolor="#FFFFFF" textAlignment="Right" uuid="a1b2c3d4-0001-0002-0003-000000000004"/>
                <textFieldExpression><![CDATA["Date: " + $P{REPORT_DATE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="370" y="42" width="170" height="18" forecolor="#D1FAE5" textAlignment="Right" uuid="a1b2c3d4-0001-0002-0003-000000000005"/>
                <textFieldExpression><![CDATA["Generated by: " + $P{GENERATED_BY}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="28" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="25" backcolor="#E2E8F0" uuid="b1b2c3d4-0001-0002-0003-000000000001"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="10" y="5" width="70" height="18" uuid="b1b2c3d4-0001-0002-0003-000000000002"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[SKU]]></text>
            </staticText>
            <staticText>
                <reportElement x="85" y="5" width="175" height="18" uuid="b1b2c3d4-0001-0002-0003-000000000003"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Product Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="265" y="5" width="90" height="18" uuid="b1b2c3d4-0001-0002-0003-000000000004"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Category]]></text>
            </staticText>
            <staticText>
                <reportElement x="360" y="5" width="55" height="18" textAlignment="Center" uuid="b1b2c3d4-0001-0002-0003-000000000005"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Qty]]></text>
            </staticText>
            <staticText>
                <reportElement x="420" y="5" width="60" height="18" textAlignment="Right" uuid="b1b2c3d4-0001-0002-0003-000000000006"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Cost]]></text>
            </staticText>
            <staticText>
                <reportElement x="485" y="5" width="60" height="18" textAlignment="Right" uuid="b1b2c3d4-0001-0002-0003-000000000007"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Selling]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="22" splitType="Stretch">
            <textField>
                <reportElement x="10" y="2" width="70" height="18" uuid="c1b2c3d4-0001-0002-0003-000000000001"/>
                <textFieldExpression><![CDATA[$F{sku}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="85" y="2" width="175" height="18" uuid="c1b2c3d4-0001-0002-0003-000000000002"/>
                <textFieldExpression><![CDATA[$F{productName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="265" y="2" width="90" height="18" uuid="c1b2c3d4-0001-0002-0003-000000000003"/>
                <textFieldExpression><![CDATA[$F{category}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="360" y="2" width="55" height="18" textAlignment="Center" uuid="c1b2c3d4-0001-0002-0003-000000000004"/>
                <textFieldExpression><![CDATA[$F{stockQuantity}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0">
                <reportElement x="420" y="2" width="60" height="18" textAlignment="Right" uuid="c1b2c3d4-0001-0002-0003-000000000005"/>
                <textFieldExpression><![CDATA[$F{costPrice}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0">
                <reportElement x="485" y="2" width="60" height="18" textAlignment="Right" uuid="c1b2c3d4-0001-0002-0003-000000000006"/>
                <textFieldExpression><![CDATA[$F{sellingPrice}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="60" splitType="Stretch">
            <line>
                <reportElement x="0" y="10" width="555" height="1" forecolor="#CBD5E1" uuid="d1b2c3d4-0001-0002-0003-000000000001"/>
            </line>
            <textField>
                <reportElement x="20" y="20" width="220" height="20" uuid="d1b2c3d4-0001-0002-0003-000000000002"/>
                <textElement><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Total Unique Products: " + $P{TOTAL_ITEMS}]]></textFieldExpression>
            </textField>
            <textField pattern="Total Valuation: #,##0 VND">
                <reportElement x="300" y="20" width="245" height="20" textAlignment="Right" forecolor="#047857" uuid="d1b2c3d4-0001-0002-0003-000000000003"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{TOTAL_VALUE}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
